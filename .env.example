# Copy to .env at the repo root and fill in. .env is gitignored — never commit it.
#   cp .env.example .env
#
# Load it before running anything that talks to a live service:
#   set -a && source .env && set +a

# --- Required: the LLM ---------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for planning / critique / synthesis.
# gemini-2.5-flash is still supported (no shutdown date announced).
# gemini-3.5-flash-lite is faster and cheaper; gemini-3.7-flash is stronger.
GEMINI_MODEL=gemini-2.5-flash

# Embedding model for the semantic-alignment score.
# NOTE: text-embedding-004 (the value this repo hardcoded) was SHUT DOWN
# 2026-01-14. gemini-embedding-001 is the stable replacement.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Structured government data sources ----------------------------------
# BEA   — https://apps.bea.gov/API/signup/
BEA_API_KEY=
# Census — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# BLS    — https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# Congress.gov — https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
# Data.gov — https://api.data.gov/signup/  (only used by the retired catalog path)
DATA_GOV_API_KEY=

# Treasury Fiscal Data and USAspending are KEYLESS — nothing to set.

# --- Web research --------------------------------------------------------
# Tavily — https://tavily.com/  (optional if Gemini google_search grounding is used)
TAVILY_API_KEY=
