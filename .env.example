# Copy to .env at the repo root and fill in. .env is gitignored — never commit it.
#   cp .env.example .env
#
# Load it before running anything that talks to a live service:
#   set -a && source .env && set +a

# --- Required: the LLM ---------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini: only used when AI_SEARCH_PROVIDER=gemini (or for /v1/verify).
# Preferred model for planning / critique / synthesis / grounded search.
# gemini-2.5-flash is RETIRED (404 "no longer available") — do not use it.
# If the preferred model is ever retired, the API falls through
# GEMINI_FALLBACK_MODELS automatically instead of going down.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest

# Embedding model for the legacy semantic-alignment score.
# text-embedding-004 was SHUT DOWN 2026-01-14.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Structured government data sources ----------------------------------
# BEA   — https://apps.bea.gov/API/signup/
BEA_API_KEY=
# Census — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# BLS    — https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# Congress.gov — https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
# Data.gov — https://api.data.gov/signup/  (only used by the retired catalog path)
DATA_GOV_API_KEY=

# Treasury Fiscal Data and USAspending are KEYLESS — nothing to set.

# --- Web research --------------------------------------------------------
# Tavily — https://tavily.com/  (optional if Gemini google_search grounding is used)
TAVILY_API_KEY=

# --- AI search tier (claims no official dataset covers) ------------------
# Anthropic API key from console.anthropic.com (NOT a claude.ai subscription).
# Create it in a DEDICATED workspace with a monthly spend limit set in the
# Console: that limit is the hard backstop above every cap below.
ANTHROPIC_API_KEY=
# claude | gemini | off   (default: claude when ANTHROPIC_API_KEY is set)
AI_SEARCH_PROVIDER=claude
CLAUDE_SEARCH_MODEL=claude-haiku-5-5

# Hard caps, enforced in code before any request is sent. Out-of-range values
# are clamped, so a typo cannot lift a cap.
AI_MAX_SPEND_USD_PER_DAY=1.00          # 0-50; includes worst case of next call
AI_MAX_CALLS_PER_DAY=100               # 0-5000, all users combined
AI_MAX_CALLS_PER_CLIENT_PER_DAY=10     # 0-500, per hashed IP
AI_MAX_SEARCHES_PER_CALL=2             # 1-3
AI_MAX_OUTPUT_TOKENS=1500              # 512-4000
AI_MAX_CLAIM_CHARS=300                 # 40-600

# Shared counters so the caps hold across all Vercel instances. Connect
# Upstash Redis from the Vercel Marketplace (sets KV_REST_API_URL/TOKEN) or
# set these. Without them the caps are per instance (weaker).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The legacy /v1/verify planner makes 4-8 uncapped model calls per request.
ENABLE_LEGACY_V1=false
