{
  "manifest_version": 3,
  "name": "Project Mirador",
  "version": "2.1.0",
  "description": "Look up official U.S. statistics and copy them with a full citation. Also verifies highlighted claims against BLS, BEA, Census and Treasury data.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project Mirador"
  },
  "commands": {
    "verify-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Check the highlighted text"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "omnibox": {
    "keyword": "mir"
  }
}
