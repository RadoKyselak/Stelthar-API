{
  "manifest_version": 3,
  "name": "Mirador: Fact Check Gov",
  "short_name": "Mirador",
  "version": "2.2.0",
  "description": "Fact-check claims against official U.S. government data in a side panel, with the exact figure and a link to its source.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Mirador fact check"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Mirador fact check"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "omnibox": {
    "keyword": "mir"
  }
}
