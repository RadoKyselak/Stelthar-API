{
  "manifest_version": 3,
  "name": "Project Mirador",
  "version": "2.1.1",
  "description": "Check a claim or look up an official U.S. statistic in a side panel, with the exact source: BLS, BEA, Census and Treasury data.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Project Mirador"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Project Mirador"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "omnibox": {
    "keyword": "mir"
  }
}
