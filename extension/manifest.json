{
  "manifest_version": 3,
  "name": "Project Mirador",
  "version": "1.8.0",
  "description": "Look up official U.S. statistics and copy them with a full citation. Also verifies highlighted claims against BLS, Treasury and Census data.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "contextMenus",
    "offscreen",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://stelthar-api.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project Mirador"
  },
  "commands": {
    "verify-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Verify the highlighted text"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "omnibox": {
    "keyword": "mir"
  }
}